
@model Jewellery.Domain.Entities.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="invoice-details-page" dir="rtl">

    <div class="page-heading">
        <div>
            <span class="eyebrow">INVOICE MANAGEMENT</span>
            <h2>تفاصيل الفاتورة</h2>
            <p>عرض بيانات الفاتورة والمنتج والعناصر والتفاصيل المالية.</p>
        </div>

        <a asp-controller="Invoices"
           asp-action="Index"
           class="back-button">
            <i class="fas fa-arrow-right"></i>
            العودة إلى الفواتير
        </a>
    </div>

    <!-- Invoice Information -->
    <div class="details-card">

        <div class="card-heading">
            <div class="heading-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
            <div>
                <h4>معلومات الفاتورة</h4>
                <span>Invoice Information</span>
            </div>
        </div>

        <div class="details-grid">

            <div class="detail-item">
                <span>رقم الفاتورة</span>
                <strong>@Model.InvoiceNumber</strong>
            </div>

            <div class="detail-item">
                <span>تاريخ الفاتورة</span>
                <strong>@Model.InvoiceDate?.ToString("dd/MM/yyyy")</strong>
            </div>

            <div class="detail-item">
                <span>البائع</span>
                <strong>@Model.SellerName</strong>
            </div>

            <div class="detail-item">
                <span>عنوان البائع</span>
                <strong>@Model.SellerAddress</strong>
            </div>

            <div class="detail-item">
                <span>العميل</span>
                <strong>@Model.CustomerName</strong>
            </div>

            <div class="detail-item">
                <span>عنوان الفوترة</span>
                <strong>@Model.BillingAddress</strong>
            </div>

            <div class="detail-item">
                <span>عنوان التوصيل</span>
                <strong>@Model.DeliveryAddress</strong>
            </div>

            <div class="detail-item">
                <span>المنتج المرتبط</span>
                <strong>@Model.Product?.Name</strong>
            </div>

        </div>
    </div>

    <!-- Invoice Items -->
    <div class="details-card">

        <div class="card-heading">
            <div class="heading-icon">
                <i class="fas fa-list-ul"></i>
            </div>
            <div>
                <h4>عناصر الفاتورة</h4>
                <span>Invoice Items</span>
            </div>

            <div class="items-count">
                @(Model.Items?.Count() ?? 0) عنصر
            </div>
        </div>

        <div class="table-responsive">
            <table class="invoice-table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>الوصف</th>
                        <th>الكمية</th>
                        <th>سعر الوحدة</th>
                        <th>السعر الإجمالي</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int counter = 1;

                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@counter</td>
                                <td class="item-description">@item.Description</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice?.ToString("N2")</td>
                                <td class="item-total">@item.TotalPrice?.ToString("N2")</td>
                            </tr>

                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-row">
                                <i class="fas fa-inbox"></i>
                                <p>لا توجد عناصر مسجلة لهذه الفاتورة.</p>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- Financial Summary -->
    <div class="financial-section">

        <div class="financial-card">

            <div class="financial-heading">
                <i class="fas fa-calculator"></i>
                <h4>الملخص المالي</h4>
            </div>

            <div class="financial-row">
                <span>المجموع الفرعي</span>
                <strong>@Model.SubTotal?.ToString("N2") @Model.Currency</strong>
            </div>

            <div class="financial-row">
                <span>الضريبة</span>
                <strong>@Model.TaxAmount?.ToString("N2") @Model.Currency</strong>
            </div>

            <div class="financial-divider"></div>

            <div class="grand-total">
                <span>الإجمالي النهائي</span>
                <strong>
                    @Model.TotalAmount?.ToString("N2") @Model.Currency
                </strong>
            </div>

        </div>

    </div>

</div>

<style>
    .invoice-details-page {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px 45px;
        color: #292929;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #a88755;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 600;
        margin: 9px 0;
    }

    .page-heading p {
        color: #999;
        font-size: 13px;
        margin: 0;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 11px 17px;
        border: 1px solid #e8e2d7;
        border-radius: 8px;
        color: #8d744f;
        text-decoration: none;
        font-size: 13px;
        transition: .2s;
        white-space: nowrap;
    }

    .back-button:hover {
        background: #f8f4ed;
        color: #795f3c;
    }

    .details-card {
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 13px;
        margin-bottom: 24px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.025);
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 24px;
        background: #fdfcf9;
        border-bottom: 1px solid #eeeae3;
    }

    .heading-icon {
        width: 43px;
        height: 43px;
        border-radius: 10px;
        background: #f5f0e7;
        color: #a88755;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .card-heading h4 {
        font-size: 15px;
        font-weight: 600;
        margin: 0 0 5px;
    }

    .card-heading span {
        color: #999;
        font-size: 11px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        padding: 24px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 15px;
        border-radius: 8px;
        background: #faf9f7;
        min-width: 0;
    }

    .detail-item span {
        color: #999;
        font-size: 12px;
    }

    .detail-item strong {
        color: #333;
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .items-count {
        margin-right: auto;
        padding: 7px 12px;
        background: #f5f0e7;
        color: #a88755;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .table-responsive {
        padding: 15px 20px 20px;
    }

    .invoice-table {
        width: 100%;
        border-collapse: collapse;
    }

    .invoice-table th {
        background: #faf9f7;
        color: #777;
        padding: 14px;
        text-align: right;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #eeeae3;
    }

    .invoice-table td {
        padding: 15px 14px;
        color: #555;
        font-size: 13px;
        border-bottom: 1px solid #f0eeea;
    }

    .invoice-table tbody tr:hover {
        background: #fdfcf9;
    }

    .item-description {
        font-weight: 600;
        color: #333 !important;
    }

    .item-total {
        color: #a88755 !important;
        font-weight: 600;
    }

    .empty-row {
        text-align: center;
        padding: 35px !important;
        color: #999 !important;
    }

    .empty-row i {
        font-size: 25px;
        margin-bottom: 10px;
        color: #c5b69d;
    }

    .empty-row p {
        margin: 0;
    }

    .financial-section {
        display: flex;
        justify-content: flex-start;
    }

    .financial-card {
        width: 100%;
        max-width: 430px;
        margin-right: auto;
        padding: 24px;
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 13px;
        box-shadow: 0 5px 20px rgba(0,0,0,.025);
    }

    .financial-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 22px;
    }

    .financial-heading i {
        color: #a88755;
        font-size: 18px;
    }

    .financial-heading h4 {
        font-size: 15px;
        font-weight: 600;
        margin: 0;
    }

    .financial-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 16px;
        font-size: 13px;
    }

    .financial-row span {
        color: #888;
    }

    .financial-row strong {
        color: #333;
        font-weight: 600;
    }

    .financial-divider {
        border-top: 1px solid #eeeae3;
        margin: 20px 0;
    }

    .grand-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 16px;
        background: #f8f2e7;
        border-radius: 9px;
    }

    .grand-total span {
        color: #6f604b;
        font-size: 13px;
        font-weight: 600;
    }

    .grand-total strong {
        color: #a88755;
        font-size: 19px;
        font-weight: 700;
        text-align: left;
    }

    @@media (max-width: 768px) {
        .page-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .details-grid {
            grid-template-columns: 1fr;
            padding: 17px;
        }

        .financial-card {
            max-width: 100%;
        }

        .table-responsive {
            padding: 10px;
        }

        .invoice-table {
            min-width: 650px;
        }
    }
</style>
