
@model List<Jewellery.Domain.Entities.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="invoices-page" dir="rtl">

    <div class="page-heading">
        <div>
            <span class="eyebrow">INVOICE MANAGEMENT</span>
            <h2>الفواتير</h2>
            <p>عرض ومتابعة جميع الفواتير المسجلة في النظام.</p>
        </div>

        <div class="invoice-count-card">
            <div class="count-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
            <div>
                <span>إجمالي الفواتير</span>
                <strong>@(Model?.Count ?? 0)</strong>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="success-message">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    <div class="invoices-card">

        <div class="card-heading">
            <div>
                <h4>سجل الفواتير</h4>
                <span>Invoices List</span>
            </div>

            <div class="list-icon">
                <i class="fas fa-list"></i>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="invoices-table">

                    <thead>
                        <tr>
                            <th>رقم الفاتورة</th>
                            <th>التاريخ</th>
                            <th>البائع</th>
                            <th>العميل</th>
                            <th>المنتج</th>
                            <th>الإجمالي</th>
                            <th>العملة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td>
                                    <span class="invoice-number">
                                        @invoice.InvoiceNumber
                                    </span>
                                </td>

                                <td>
                                    @invoice.InvoiceDate?.ToString("dd/MM/yyyy")
                                </td>

                                <td>@invoice.SellerName</td>

                                <td>@invoice.CustomerName</td>

                                <td>
                                    @invoice.Product?.Name
                                </td>

                                <td>
                                    <strong class="invoice-total">
                                        @invoice.TotalAmount?.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="currency-label">
                                        @invoice.Currency
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.Id"
                                       class="details-button">
                                        <i class="fas fa-eye"></i>
                                        التفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-file-invoice"></i>
                </div>

                <h4>لا توجد فواتير حتى الآن</h4>
                <p>ستظهر الفواتير هنا بعد إضافتها إلى النظام.</p>
            </div>
        }

        <div class="table-footer">
            <span>
                عدد السجلات:
                <strong>@(Model?.Count ?? 0)</strong>
            </span>
        </div>

    </div>

</div>

<style>
    .invoices-page {
        max-width: 1250px;
        margin: 40px auto;
        padding: 0 20px 45px;
        color: #292929;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #a88755;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 600;
        margin: 9px 0;
    }

    .page-heading p {
        color: #999;
        font-size: 13px;
        margin: 0;
    }

    .invoice-count-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px 20px;
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 11px;
        min-width: 175px;
    }

    .count-icon,
    .list-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f0e7;
        color: #a88755;
        border-radius: 10px;
        font-size: 19px;
    }

    .invoice-count-card span {
        display: block;
        color: #999;
        font-size: 11px;
        margin-bottom: 4px;
    }

    .invoice-count-card strong {
        display: block;
        font-size: 20px;
        color: #333;
    }

    .success-message {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 17px;
        margin-bottom: 20px;
        border: 1px solid #dcebd9;
        background: #f2f8f1;
        color: #54805a;
        border-radius: 9px;
        font-size: 13px;
    }

    .invoices-card {
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 13px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.025);
    }

    .card-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        background: #fdfcf9;
        border-bottom: 1px solid #eeeae3;
    }

    .card-heading h4 {
        font-size: 15px;
        font-weight: 600;
        margin: 0 0 5px;
    }

    .card-heading span {
        color: #999;
        font-size: 11px;
    }

    .table-responsive {
        padding: 15px 20px;
    }

    .invoices-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

    .invoices-table th {
        padding: 15px 12px;
        background: #faf9f7;
        color: #777;
        text-align: right;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #eeeae3;
    }

    .invoices-table td {
        padding: 16px 12px;
        color: #666;
        font-size: 12px;
        border-bottom: 1px solid #f0eeea;
        vertical-align: middle;
    }

    .invoices-table tbody tr {
        transition: background .2s;
    }

    .invoices-table tbody tr:hover {
        background: #fdfcf9;
    }

    .invoice-number {
        color: #a88755;
        font-weight: 700;
    }

    .invoice-total {
        color: #333;
        font-size: 13px;
    }

    .currency-label {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 6px;
        background: #f5f0e7;
        color: #94764d;
        font-size: 11px;
        font-weight: 600;
    }

    .details-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 7px;
        background: #f5f0e7;
        color: #94764d;
        text-decoration: none;
        font-size: 11px;
        font-weight: 600;
        transition: .2s;
    }

    .details-button:hover {
        background: #a88755;
        color: #fff;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f5f0e7;
        color: #a88755;
        font-size: 25px;
    }

    .empty-state h4 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #999;
        font-size: 13px;
        margin: 0;
    }

    .table-footer {
        padding: 15px 23px;
        background: #fdfcf9;
        border-top: 1px solid #eeeae3;
        color: #999;
        font-size: 12px;
    }

    .table-footer strong {
        color: #a88755;
    }

    @@media (max-width: 768px) {
        .page-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .invoice-count-card {
            width: 100%;
        }

        .table-responsive {
            padding: 10px;
        }

        .invoices-table {
            min-width: 950px;
        }
    }
</style>
