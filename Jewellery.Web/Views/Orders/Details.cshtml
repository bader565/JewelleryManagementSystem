
@model Jewellery.Application.DTOs.Orders.OrderDto

@{
    ViewData["Title"] = "تفاصيل الطلب";
}

<div class="order-details-page" dir="rtl">

    <div class="page-heading">
        <div>
            <span class="eyebrow">ORDER MANAGEMENT</span>
            <h2>تفاصيل الطلب</h2>
            <p>مراجعة معلومات العميل والمنتجات وحالة الطلب.</p>
        </div>

        <a asp-controller="Orders"
           asp-action="Index"
           class="back-button">
            <i class="fas fa-arrow-right"></i>
            العودة للطلبات
        </a>
    </div>

    <!-- Order Information -->
    <div class="details-card">

        <div class="card-heading">
            <div class="heading-icon">
                <i class="fas fa-shopping-bag"></i>
            </div>

            <div>
                <h4>معلومات الطلب</h4>
                <span>Order Information</span>
            </div>

            <div class="status-badge">
                @Model.Status
            </div>
        </div>

        <div class="details-grid">

            <div class="detail-item">
                <span>رقم الطلب</span>
                <strong>@Model.OrderNumber</strong>
            </div>

            <div class="detail-item">
                <span>اسم العميل</span>
                <strong>@Model.CustomerName</strong>
            </div>

            <div class="detail-item">
                <span>رقم الهاتف</span>
                <strong>@Model.CustomerPhone</strong>
            </div>

            <div class="detail-item">
                <span>البريد الإلكتروني</span>
                <strong>@(Model.CustomerEmail ?? "-")</strong>
            </div>

            <div class="detail-item">
                <span>المدينة</span>
                <strong>@Model.City</strong>
            </div>

            <div class="detail-item">
                <span>تاريخ الطلب</span>
                <strong>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</strong>
            </div>

            <div class="detail-item full-width">
                <span>عنوان التوصيل</span>
                <strong>@Model.ShippingAddress</strong>
            </div>

            <div class="detail-item full-width">
                <span>ملاحظات العميل</span>
                <strong>@(Model.Notes ?? "-")</strong>
            </div>

        </div>
    </div>

    <!-- Order Items -->
    <div class="details-card">

        <div class="card-heading">
            <div class="heading-icon">
                <i class="fas fa-gem"></i>
            </div>

            <div>
                <h4>المنتجات المطلوبة</h4>
                <span>Order Items</span>
            </div>

            <div class="items-count">
                @(Model.Items?.Count() ?? 0) منتج
            </div>
        </div>

        <div class="table-responsive">

            <table class="order-table">

                <thead>
                    <tr>
                        <th>الصورة</th>
                        <th>المنتج</th>
                        <th>السعر</th>
                        <th>الكمية</th>
                        <th>الإجمالي</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                    {
                                        <img src="@item.ProductImageUrl"
                                             alt="@item.ProductName"
                                             class="product-image" />
                                    }
                                    else
                                    {
                                        <div class="no-image">
                                            <i class="fas fa-gem"></i>
                                        </div>
                                    }
                                </td>

                                <td class="product-name">
                                    @item.ProductName
                                </td>

                                <td>@item.UnitPrice.ToString("N2")</td>

                                <td>
                                    <span class="quantity-label">
                                        @item.Quantity
                                    </span>
                                </td>

                                <td class="item-total">
                                    @item.TotalPrice.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-row">
                                لا توجد منتجات مرتبطة بهذا الطلب.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <!-- Total -->
        <div class="order-total-section">
            <div class="order-total-card">
                <span>الإجمالي النهائي</span>
                <strong>@Model.TotalAmount.ToString("N2")</strong>
            </div>
        </div>

    </div>

</div>

<style>
    .order-details-page {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px 45px;
        color: #292929;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #a88755;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 600;
        margin: 9px 0;
    }

    .page-heading p {
        color: #999;
        font-size: 13px;
        margin: 0;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 11px 17px;
        border: 1px solid #e8e2d7;
        border-radius: 8px;
        color: #8d744f;
        text-decoration: none;
        font-size: 13px;
        white-space: nowrap;
        transition: .2s;
    }

    .back-button:hover {
        background: #f8f4ed;
        color: #795f3c;
    }

    .details-card {
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 13px;
        margin-bottom: 24px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.025);
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 24px;
        background: #fdfcf9;
        border-bottom: 1px solid #eeeae3;
    }

    .heading-icon {
        width: 43px;
        height: 43px;
        border-radius: 10px;
        background: #f5f0e7;
        color: #a88755;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .card-heading h4 {
        font-size: 15px;
        font-weight: 600;
        margin: 0 0 5px;
    }

    .card-heading span {
        color: #999;
        font-size: 11px;
    }

    .status-badge {
        margin-right: auto;
        padding: 7px 13px;
        border-radius: 20px;
        background: #f8f2e7;
        color: #94764d;
        font-size: 12px;
        font-weight: 600;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        padding: 24px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 15px;
        background: #faf9f7;
        border-radius: 8px;
        min-width: 0;
    }

    .detail-item span {
        color: #999;
        font-size: 12px;
    }

    .detail-item strong {
        color: #333;
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .items-count {
        margin-right: auto;
        padding: 7px 12px;
        background: #f5f0e7;
        color: #a88755;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .table-responsive {
        padding: 15px 20px;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
    }

    .order-table th {
        padding: 14px;
        background: #faf9f7;
        color: #777;
        text-align: right;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #eeeae3;
    }

    .order-table td {
        padding: 14px;
        color: #555;
        font-size: 13px;
        border-bottom: 1px solid #f0eeea;
        vertical-align: middle;
    }

    .order-table tbody tr:hover {
        background: #fdfcf9;
    }

    .product-image,
    .no-image {
        width: 65px;
        height: 65px;
        border-radius: 9px;
        object-fit: cover;
    }

    .no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f0e7;
        color: #a88755;
        font-size: 21px;
    }

    .product-name {
        font-weight: 600;
        color: #333 !important;
    }

    .quantity-label {
        display: inline-block;
        min-width: 32px;
        padding: 6px 10px;
        text-align: center;
        border-radius: 6px;
        background: #f5f0e7;
        color: #94764d;
        font-weight: 600;
    }

    .item-total {
        color: #a88755 !important;
        font-weight: 600;
    }

    .empty-row {
        text-align: center;
        padding: 35px !important;
        color: #999 !important;
    }

    .order-total-section {
        display: flex;
        justify-content: flex-start;
        padding: 10px 24px 24px;
    }

    .order-total-card {
        width: 100%;
        max-width: 350px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: #f8f2e7;
        border-radius: 10px;
    }

    .order-total-card span {
        color: #6f604b;
        font-size: 13px;
        font-weight: 600;
    }

    .order-total-card strong {
        color: #a88755;
        font-size: 21px;
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .page-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .details-grid {
            grid-template-columns: 1fr;
            padding: 17px;
        }

        .full-width {
            grid-column: auto;
        }

        .table-responsive {
            padding: 10px;
        }

        .order-table {
            min-width: 650px;
        }

        .order-total-card {
            max-width: 100%;
        }
    }
</style>
