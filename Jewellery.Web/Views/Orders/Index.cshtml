
@model List<Jewellery.Application.DTOs.Orders.OrderDto>

@{
    ViewData["Title"] = "إدارة الطلبات";
}

<div class="orders-page" dir="rtl">

    <div class="page-heading">
        <div>
            <span class="eyebrow">ORDER MANAGEMENT</span>
            <h2>إدارة الطلبات</h2>
            <p>متابعة طلبات العملاء ومراجعة حالتها وتفاصيلها.</p>
        </div>

        <div class="orders-count-card">
            <div class="count-icon">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <div>
                <span>إجمالي الطلبات</span>
                <strong>@(Model?.Count ?? 0)</strong>
            </div>
        </div>
    </div>

    <div class="orders-card">

        <div class="card-heading">
            <div>
                <h4>قائمة الطلبات</h4>
                <span>Orders List</span>
            </div>

            <div class="list-icon">
                <i class="fas fa-list"></i>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-shopping-bag"></i>
                </div>

                <h4>لا توجد طلبات حالياً</h4>
                <p>ستظهر طلبات العملاء هنا عند إتمام عمليات الشراء.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="orders-table">

                    <thead>
                        <tr>
                            <th>رقم الطلب</th>
                            <th>اسم العميل</th>
                            <th>الهاتف</th>
                            <th>المدينة</th>
                            <th>إجمالي الطلب</th>
                            <th>الحالة</th>
                            <th>تاريخ الطلب</th>
                            <th>التفاصيل</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    <span class="order-number">
                                        @order.OrderNumber
                                    </span>
                                </td>

                                <td class="customer-name">
                                    @order.CustomerName
                                </td>

                                <td>@order.CustomerPhone</td>

                                <td>@order.City</td>

                                <td>
                                    <strong class="order-total">
                                        @order.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @switch (order.Status)
                                    {
                                        case Jewellery.Domain.Enums.OrderStatus.Pending:
                                            <span class="status-badge pending">
                                                <i class="fas fa-clock"></i>
                                                قيد الانتظار
                                            </span>
                                            break;

                                        case Jewellery.Domain.Enums.OrderStatus.Confirmed:
                                            <span class="status-badge confirmed">
                                                <i class="fas fa-check-circle"></i>
                                                تم التأكيد
                                            </span>
                                            break;

                                        case Jewellery.Domain.Enums.OrderStatus.Shipped:
                                            <span class="status-badge shipped">
                                                <i class="fas fa-truck"></i>
                                                تم الشحن
                                            </span>
                                            break;

                                        case Jewellery.Domain.Enums.OrderStatus.Delivered:
                                            <span class="status-badge delivered">
                                                <i class="fas fa-check-double"></i>
                                                تم التسليم
                                            </span>
                                            break;

                                        case Jewellery.Domain.Enums.OrderStatus.Cancelled:
                                            <span class="status-badge cancelled">
                                                <i class="fas fa-times-circle"></i>
                                                ملغي
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="order-date">
                                    @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>
                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="details-button">
                                        <i class="fas fa-eye"></i>
                                        التفاصيل
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

        <div class="table-footer">
            عدد الطلبات:
            <strong>@(Model?.Count ?? 0)</strong>
        </div>

    </div>

</div>

<style>
    .orders-page {
        max-width: 1250px;
        margin: 40px auto;
        padding: 0 20px 45px;
        color: #292929;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #a88755;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 600;
        margin: 9px 0;
    }

    .page-heading p {
        color: #999;
        font-size: 13px;
        margin: 0;
    }

    .orders-count-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px 20px;
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 11px;
        min-width: 175px;
    }

    .count-icon,
    .list-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f0e7;
        color: #a88755;
        border-radius: 10px;
        font-size: 19px;
    }

    .orders-count-card span {
        display: block;
        color: #999;
        font-size: 11px;
        margin-bottom: 4px;
    }

    .orders-count-card strong {
        display: block;
        font-size: 20px;
        color: #333;
    }

    .orders-card {
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 13px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.025);
    }

    .card-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        background: #fdfcf9;
        border-bottom: 1px solid #eeeae3;
    }

    .card-heading h4 {
        font-size: 15px;
        font-weight: 600;
        margin: 0 0 5px;
    }

    .card-heading span {
        color: #999;
        font-size: 11px;
    }

    .table-responsive {
        padding: 15px 20px;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

    .orders-table th {
        padding: 15px 12px;
        background: #faf9f7;
        color: #777;
        text-align: right;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #eeeae3;
    }

    .orders-table td {
        padding: 15px 12px;
        color: #666;
        font-size: 12px;
        border-bottom: 1px solid #f0eeea;
        vertical-align: middle;
    }

    .orders-table tbody tr {
        transition: background .2s;
    }

    .orders-table tbody tr:hover {
        background: #fdfcf9;
    }

    .order-number {
        color: #a88755;
        font-weight: 700;
    }

    .customer-name {
        color: #333 !important;
        font-weight: 600;
    }

    .order-total {
        color: #333;
        font-size: 13px;
    }

    .order-date {
        color: #888 !important;
        font-size: 11px !important;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-badge.pending {
        background: #fff4dc;
        color: #a47727;
    }

    .status-badge.confirmed {
        background: #eaf3f8;
        color: #4d819d;
    }

    .status-badge.shipped {
        background: #edf0fa;
        color: #6575ae;
    }

    .status-badge.delivered {
        background: #eaf5eb;
        color: #54805a;
    }

    .status-badge.cancelled {
        background: #fbeeed;
        color: #b65d55;
    }

    .details-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 7px;
        background: #f5f0e7;
        color: #94764d;
        text-decoration: none;
        font-size: 11px;
        font-weight: 600;
        transition: .2s;
    }

    .details-button:hover {
        background: #a88755;
        color: #fff;
    }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f5f0e7;
        color: #a88755;
        font-size: 25px;
    }

    .empty-state h4 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #999;
        font-size: 13px;
        margin: 0;
    }

    .table-footer {
        padding: 15px 23px;
        background: #fdfcf9;
        border-top: 1px solid #eeeae3;
        color: #999;
        font-size: 12px;
    }

    .table-footer strong {
        color: #a88755;
    }

    @@media (max-width: 768px) {
        .page-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .orders-count-card {
            width: 100%;
        }

        .table-responsive {
            padding: 10px;
        }

        .orders-table {
            min-width: 950px;
        }
    }
</style>
