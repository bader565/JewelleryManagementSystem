@model Jewellery.Web.Models.Products.CreateProductViewModel

@{
    ViewData["Title"] = "إضافة منتج جديد";
}

<div class="product-create-page" dir="rtl">

    <div class="page-heading">
        <div>
            <span class="section-eyebrow">PRODUCT MANAGEMENT</span>
            <h2>إضافة قطعة مجوهرات جديدة</h2>
            <p>أدخل تفاصيل القطعة لإضافتها إلى مخزون المتجر</p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn-back">
            ← العودة للمنتجات
        </a>
    </div>

    <form asp-controller="Products"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="create-layout">

            <div class="create-main">

                <!-- Basic Information -->

                <div class="luxury-card">

                    <div class="card-heading">
                        <div class="heading-icon">◇</div>
                        <div>
                            <h5>المعلومات الأساسية</h5>
                            <span>بيانات تعريف القطعة</span>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-7">
                            <label asp-for="Name" class="form-label">
                                اسم المنتج *
                            </label>

                            <input asp-for="Name"
                                   class="form-control luxury-input"
                                   placeholder="مثال: خاتم ذهب عيار 21" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Barcode" class="form-label">
                                الباركود
                            </label>

                            <input asp-for="Barcode"
                                   class="form-control luxury-input"
                                   placeholder="أدخل الباركود" />

                            <span asp-validation-for="Barcode"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                وصف القطعة
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control luxury-input"
                                      rows="3"
                                      placeholder="اكتب وصفاً مختصراً للقطعة..."></textarea>
                        </div>

                    </div>

                </div>

                <!-- Product Images -->

                <div class="luxury-card">

                    <div class="card-heading">
                        <div class="heading-icon">▧</div>
                        <div>
                            <h5>صور المنتج</h5>
                            <span>أضف صوراً واضحة للقطعة لعرضها في المتجر</span>
                        </div>
                    </div>

                    <div class="image-upload-area">

                        <label for="productImages"
                               class="image-upload-label">

                            <div class="upload-icon">＋</div>

                            <h6>اختر صور المنتج</h6>

                            <p>يمكنك اختيار أكثر من صورة</p>

                            <span>
                                JPG, PNG, WEBP — الحد الأقصى 5 MB للصورة
                            </span>

                        </label>

                        <input type="file"
                               id="productImages"
                               name="Images"
                               accept=".jpg,.jpeg,.png,.webp"
                               multiple
                               class="d-none" />

                        <div id="imagePreview"
                             class="image-preview-grid">
                        </div>

                    </div>

                </div>

                <!-- Gold Details -->

                <div class="luxury-card">

                    <div class="card-heading">
                        <div class="heading-icon">✦</div>
                        <div>
                            <h5>تفاصيل الذهب</h5>
                            <span>العيار والوزن والكمية</span>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label asp-for="Karat" class="form-label">
                                عيار الذهب *
                            </label>

                            <select asp-for="Karat"
                                    asp-items="Html.GetEnumSelectList<Jewellery.Domain.Enums.GoldKarat>()"
                                    class="form-select luxury-input">

                                <option value="">اختر العيار</option>

                            </select>

                            <span asp-validation-for="Karat"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Weight" class="form-label">
                                الوزن بالغرام *
                            </label>

                            <div class="input-group">
                                <input asp-for="Weight"
                                       type="number"
                                       step="0.001"
                                       min="0.001"
                                       class="form-control luxury-input"
                                       placeholder="0.000" />

                                <span class="input-group-text gold-addon">
                                    غرام
                                </span>
                            </div>

                            <span asp-validation-for="Weight"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Quantity" class="form-label">
                                الكمية *
                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="0"
                                   class="form-control luxury-input"
                                   placeholder="0" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Prices -->

                <div class="luxury-card">

                    <div class="card-heading">
                        <div class="heading-icon">＄</div>
                        <div>
                            <h5>التفاصيل المالية</h5>
                            <span>أسعار شراء وبيع القطعة</span>
                        </div>
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label asp-for="PurchasePrice" class="form-label">
                                سعر الشراء *
                            </label>

                            <div class="input-group">
                                <input asp-for="PurchasePrice"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control luxury-input"
                                       placeholder="0.00" />

                                <span class="input-group-text gold-addon">
                                    د.أ
                                </span>
                            </div>

                            <span asp-validation-for="PurchasePrice"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="SellingPrice" class="form-label">
                                سعر البيع *
                            </label>

                            <div class="input-group">
                                <input asp-for="SellingPrice"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control luxury-input"
                                       placeholder="0.00" />

                                <span class="input-group-text gold-addon">
                                    د.أ
                                </span>
                            </div>

                            <span asp-validation-for="SellingPrice"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Side Panel -->

            <div class="create-side">

                <div class="preview-card">

                    <div class="preview-symbol">✦</div>

                    <span class="preview-label">NEW COLLECTION</span>

                    <h4>قطعة جديدة</h4>

                    <p>أضف قطعة جديدة إلى مجموعة مجوهراتك</p>

                    <div class="preview-divider"></div>

                    <div class="preview-detail">
                        <span>الوزن</span>
                        <strong>حسب الإدخال</strong>
                    </div>

                    <div class="preview-detail">
                        <span>العيار</span>
                        <strong>حسب الإدخال</strong>
                    </div>

                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn-save-product">
                        ✦ حفظ المنتج
                    </button>

                    <a asp-action="Index"
                       class="btn-cancel-product">
                        إلغاء
                    </a>

                </div>

                <div class="secure-note">
                    <span>✓</span>
                    سيتم حفظ بيانات القطعة في قاعدة البيانات
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById('productImages');
        const previewContainer = document.getElementById('imagePreview');

        imageInput.addEventListener('change', function () {

            previewContainer.innerHTML = '';

            const files = Array.from(this.files);

            files.forEach(file => {

                const allowedTypes = [
                    'image/jpeg',
                    'image/png',
                    'image/webp'
                ];

                if (!allowedTypes.includes(file.type)) {
                    alert('نوع الصورة غير مدعوم: ' + file.name);
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert('حجم الصورة يجب ألا يتجاوز 5 MB: ' + file.name);
                    return;
                }

                const reader = new FileReader();

                reader.onload = function (e) {

                    const image = document.createElement('img');

                    image.src = e.target.result;
                    image.className = 'product-preview-image';

                    previewContainer.appendChild(image);
                };

                reader.readAsDataURL(file);
            });
        });
    </script>
}

<style>
    .product-create-page {
        direction: rtl;
        color: #292929;
        padding: 15px 0 40px;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .section-eyebrow {
        color: #b08d57;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 700;
        margin: 10px 0;
    }

    .page-heading p {
        color: #999;
        font-size: 14px;
        margin: 0;
    }

    .btn-back {
        background: #fff;
        color: #555;
        border: 1px solid #e9e6e0;
        border-radius: 7px;
        padding: 10px 18px;
        text-decoration: none;
        font-size: 13px;
        transition: .2s;
    }

    .btn-back:hover {
        background: #f7f5f1;
        color: #a88755;
        border-color: #d9c6a7;
    }

    .create-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 290px;
        gap: 24px;
        align-items: start;
    }

    .create-main {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .luxury-card {
        background: #fff;
        border: 1px solid #eeeae4;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,.025);
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 20px;
        margin-bottom: 24px;
        border-bottom: 1px solid #f0eee9;
    }

    .heading-icon {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        background: #f7f4ee;
        color: #a88755;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .card-heading h5 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .card-heading span {
        color: #999;
        font-size: 12px;
    }

    .product-create-page .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #444;
        margin-bottom: 9px;
    }

    .luxury-input {
        border: 1px solid #e8e5df;
        border-radius: 7px !important;
        min-height: 44px;
        font-size: 13px;
        color: #333;
        background-color: #fff;
        padding: 10px 13px;
        box-shadow: none !important;
    }

    .luxury-input:focus {
        border-color: #b08d57;
        outline: none;
    }

    textarea.luxury-input {
        min-height: auto;
    }

    .gold-addon {
        background: #f7f5f1;
        border: 1px solid #e8e5df;
        color: #9b7848;
        font-size: 13px;
        border-radius: 7px 0 0 7px !important;
    }

    .image-upload-area {
        border: 1px dashed #d9d1c3;
        border-radius: 10px;
        background: #fcfbf9;
        padding: 25px;
        text-align: center;
    }

    .image-upload-label {
        cursor: pointer;
        display: block;
        margin: 0;
    }

    .upload-icon {
        width: 48px;
        height: 48px;
        background: #f3efe7;
        color: #a88755;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 27px;
        margin: 0 auto 12px;
    }

    .image-upload-label h6 {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 7px;
    }

    .image-upload-label p {
        color: #888;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .image-upload-label span {
        color: #aaa;
        font-size: 11px;
    }

    .image-preview-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 20px;
    }

    .product-preview-image {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 9px;
        border: 1px solid #e8e5df;
        padding: 3px;
        background: white;
    }

    .create-side {
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: sticky;
        top: 20px;
    }

    .preview-card {
        background: #f7f5f1;
        border: 1px solid #eeeae4;
        border-radius: 12px;
        padding: 25px;
        text-align: center;
    }

    .preview-symbol {
        font-size: 42px;
        color: #b08d57;
        margin-bottom: 12px;
    }

    .preview-label {
        font-size: 10px;
        letter-spacing: 2px;
        color: #a88755;
        font-weight: 700;
    }

    .preview-card h4 {
        font-size: 19px;
        font-weight: 700;
        margin: 12px 0;
    }

    .preview-card p {
        color: #888;
        font-size: 13px;
        line-height: 1.8;
    }

    .preview-divider {
        border-top: 1px solid #e6e0d5;
        margin: 20px 0;
    }

    .preview-detail {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        margin-bottom: 13px;
    }

    .preview-detail span {
        color: #888;
    }

    .preview-detail strong {
        color: #444;
    }

    .form-actions {
        background: #fff;
        border: 1px solid #eeeae4;
        border-radius: 12px;
        padding: 18px;
    }

    .btn-save-product {
        width: 100%;
        background: #292929;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 13px;
        font-size: 14px;
        font-weight: 600;
        transition: .2s;
    }

    .btn-save-product:hover {
        background: #a88755;
    }

    .btn-cancel-product {
        display: block;
        text-align: center;
        color: #777;
        text-decoration: none;
        padding: 12px;
        font-size: 13px;
    }

    .btn-cancel-product:hover {
        color: #a88755;
    }

    .secure-note {
        color: #888;
        font-size: 11px;
        text-align: center;
        line-height: 1.8;
    }

    .secure-note span {
        color: #6b9b78;
        font-weight: bold;
        margin-left: 5px;
    }

    .product-create-page .text-danger {
        font-size: 12px;
    }

    @@media (max-width: 991px) {
        .create-layout {
            grid-template-columns: 1fr;
        }

        .create-side {
            position: static;
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: start;
        }

        .secure-note {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 576px) {
        .luxury-card {
            padding: 18px;
        }

        .create-side {
            display: flex;
        }

        .page-heading h2 {
            font-size: 22px;
        }
    }
</style>
