@model Jewellery.Application.DTOs.Products.ProductDto

@{
    ViewData["Title"] = "حذف المنتج";
}

<div class="product-create-page" dir="rtl">

    <div class="page-heading">
        <div>
            <span class="section-eyebrow">PRODUCT MANAGEMENT</span>
            <h2>حذف قطعة مجوهرات</h2>
            <p>راجع بيانات القطعة قبل تأكيد عملية الحذف</p>
        </div>

        <a asp-action="Index" class="btn-back">
            ← العودة للمنتجات
        </a>
    </div>

    <div class="delete-container">

        <div class="delete-card">

            <div class="delete-icon">
                <span>!</span>
            </div>

            <span class="delete-eyebrow">DELETE CONFIRMATION</span>

            <h3>هل أنت متأكد من حذف هذه القطعة؟</h3>

            <p class="delete-description">
                سيتم حذف المنتج من قاعدة البيانات، ولا يمكن التراجع عن هذه العملية.
            </p>

            <div class="delete-product-info">

                <div class="delete-product-header">
                    <div class="heading-icon">◇</div>

                    <div>
                        <h5>تفاصيل المنتج</h5>
                        <span>المنتج الذي اخترته للحذف</span>
                    </div>
                </div>

                <div class="delete-details-grid">

                    <div class="delete-detail">
                        <span>اسم المنتج</span>
                        <strong>@Model.Name</strong>
                    </div>

                    <div class="delete-detail">
                        <span>رقم المنتج</span>
                        <strong>#@Model.Id</strong>
                    </div>

                    <div class="delete-detail">
                        <span>عيار الذهب</span>
                        <strong>@Model.Karat</strong>
                    </div>

                    <div class="delete-detail">
                        <span>الوزن</span>
                        <strong>@Model.Weight غرام</strong>
                    </div>

                    <div class="delete-detail">
                        <span>سعر البيع</span>
                        <strong>@Model.SellingPrice.ToString("N2") د.أ</strong>
                    </div>

                    <div class="delete-detail">
                        <span>الكمية</span>
                        <strong>@Model.Quantity</strong>
                    </div>

                </div>

            </div>

            <div class="delete-warning">
                <span>⚠</span>
                <div>
                    <strong>تنبيه مهم</strong>
                    <p>تأكد من أنك اخترت القطعة الصحيحة قبل متابعة الحذف.</p>
                </div>
            </div>

            <form asp-controller="Products"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="delete-actions">

                    <button type="submit" class="btn-confirm-delete">
                        حذف المنتج نهائياً
                    </button>

                    <a asp-action="Index" class="btn-cancel-delete">
                        إلغاء والعودة
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<style>
    .product-create-page {
        max-width: 1100px;
        margin: 35px auto;
        padding: 0 18px;
        color: #292929;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 15px;
    }

    .section-eyebrow,
    .delete-eyebrow {
        color: #a88755;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 600;
        margin: 8px 0;
    }

    .page-heading p {
        color: #888;
        margin: 0;
    }

    .btn-back {
        color: #555;
        text-decoration: none;
        border: 1px solid #e8e5df;
        padding: 10px 18px;
        border-radius: 8px;
        transition: .2s;
    }

    .btn-back:hover {
        background: #f7f5f1;
        color: #a88755;
    }

    .delete-container {
        display: flex;
        justify-content: center;
        padding: 15px 0 45px;
    }

    .delete-card {
        width: 100%;
        max-width: 680px;
        background: #fff;
        border: 1px solid #eeeae3;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 8px 30px rgba(0,0,0,.035);
        text-align: center;
    }

    .delete-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #fff3f1;
        color: #c65b50;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        font-size: 30px;
        font-weight: 600;
    }

    .delete-card h3 {
        font-size: 21px;
        font-weight: 600;
        margin: 12px 0;
    }

    .delete-description {
        color: #888;
        font-size: 14px;
        margin-bottom: 28px;
    }

    .delete-product-info {
        text-align: right;
        border: 1px solid #eeeae3;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 20px;
        background: #fdfcfb;
    }

    .delete-product-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eeeae3;
        margin-bottom: 18px;
    }

    .heading-icon {
        width: 40px;
        height: 40px;
        background: #f5f0e7;
        color: #a88755;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .delete-product-header h5 {
        margin: 0 0 4px;
        font-weight: 600;
        font-size: 15px;
    }

    .delete-product-header span {
        color: #999;
        font-size: 12px;
    }

    .delete-details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .delete-detail {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .delete-detail span {
        color: #999;
        font-size: 12px;
    }

    .delete-detail strong {
        color: #333;
        font-size: 14px;
        font-weight: 600;
    }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        text-align: right;
        background: #fffaf0;
        border: 1px solid #f1e5c9;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 25px;
        color: #92733e;
    }

    .delete-warning > span {
        font-size: 20px;
    }

    .delete-warning strong {
        font-size: 13px;
    }

    .delete-warning p {
        font-size: 12px;
        margin: 5px 0 0;
        color: #927f5d;
    }

    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .btn-confirm-delete,
    .btn-cancel-delete {
        border: none;
        border-radius: 8px;
        padding: 12px 25px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: .2s;
    }

    .btn-confirm-delete {
        background: #b84e46;
        color: #fff;
    }

    .btn-confirm-delete:hover {
        background: #983d37;
    }

    .btn-cancel-delete {
        background: #f3f2ef;
        color: #555;
    }

    .btn-cancel-delete:hover {
        background: #e8e6e1;
        color: #222;
    }

    @@media (max-width: 576px) {
        .page-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .delete-card {
            padding: 22px 16px;
        }

        .delete-details-grid {
            grid-template-columns: 1fr;
        }

        .delete-actions {
            flex-direction: column;
        }

        .delete-actions button,
        .delete-actions a {
            width: 100%;
            text-align: center;
        }
    }
</style>
