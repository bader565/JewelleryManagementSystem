@model Jewellery.Web.Models.Products.UpdateProductViewModel
@{
    ViewData["Title"] = "تعديل المنتج";
}

<div class="product-create-page" dir="rtl">

    <!-- Page Header -->

    <div class="page-heading">

        <div>
            <span class="section-eyebrow">PRODUCT MANAGEMENT</span>

            <h2>تعديل قطعة مجوهرات</h2>

            <p>قم بتحديث بيانات القطعة وتفاصيلها المالية</p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn-back">
            ← العودة للمنتجات
        </a>

    </div>

    @* enctype is REQUIRED, otherwise the files never reach the server *@
    <form asp-controller="Products"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="create-layout">

            <!-- Main Form -->

            <div class="create-main">

                <!-- Basic Information -->

                <div class="luxury-card">

                    <div class="card-heading">

                        <div class="heading-icon">◇</div>

                        <div>
                            <h5>المعلومات الأساسية</h5>
                            <span>بيانات تعريف القطعة</span>
                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-7">

                            <label asp-for="Name" class="form-label">
                                اسم المنتج *
                            </label>

                            <input asp-for="Name"
                                   class="form-control luxury-input"
                                   placeholder="اسم القطعة" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-5">

                            <label asp-for="Barcode" class="form-label">
                                الباركود
                            </label>

                            <input asp-for="Barcode"
                                   class="form-control luxury-input"
                                   placeholder="رقم الباركود" />

                            <span asp-validation-for="Barcode"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-12">

                            <label asp-for="Description" class="form-label">
                                وصف القطعة
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control luxury-input"
                                      rows="3"
                                      placeholder="وصف القطعة..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Gold Information -->

                <div class="luxury-card">

                    <div class="card-heading">

                        <div class="heading-icon">✦</div>

                        <div>
                            <h5>تفاصيل الذهب</h5>
                            <span>العيار والوزن والكمية</span>
                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label asp-for="Karat" class="form-label">
                                عيار الذهب *
                            </label>

                            <select asp-for="Karat"
                                    asp-items="Html.GetEnumSelectList<Jewellery.Domain.Enums.GoldKarat>()"
                                    class="form-select luxury-input">
                            </select>

                            <span asp-validation-for="Karat"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Weight" class="form-label">
                                الوزن بالغرام *
                            </label>

                            <div class="input-group">

                                <input asp-for="Weight"
                                       type="number"
                                       step="0.001"
                                       min="0.001"
                                       class="form-control luxury-input" />

                                <span class="input-group-text gold-addon">
                                    غرام
                                </span>

                            </div>

                            <span asp-validation-for="Weight"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Quantity" class="form-label">
                                الكمية *
                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="0"
                                   class="form-control luxury-input" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Financial Information -->

                <div class="luxury-card">

                    <div class="card-heading">

                        <div class="heading-icon">＄</div>

                        <div>
                            <h5>التفاصيل المالية</h5>
                            <span>أسعار الشراء والبيع</span>
                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label asp-for="PurchasePrice" class="form-label">
                                سعر الشراء *
                            </label>

                            <div class="input-group">

                                <input asp-for="PurchasePrice"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control luxury-input" />

                                <span class="input-group-text gold-addon">
                                    د.أ
                                </span>

                            </div>

                            <span asp-validation-for="PurchasePrice"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="SellingPrice" class="form-label">
                                سعر البيع *
                            </label>

                            <div class="input-group">

                                <input asp-for="SellingPrice"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control luxury-input" />

                                <span class="input-group-text gold-addon">
                                    د.أ
                                </span>

                            </div>

                            <span asp-validation-for="SellingPrice"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Product Images -->

                <div class="luxury-card">

                    <div class="card-heading">

                        <div class="heading-icon">▣</div>

                        <div>
                            <h5>صور المنتج</h5>
                            <span>الصور الحالية والصور الجديدة</span>
                        </div>

                    </div>

                    @if (Model.ExistingImages is { Count: > 0 })
                    {
                        <p class="image-hint">
                            الصور الحالية. حدّد "حذف" تحت أي صورة تريد إزالتها عند الحفظ.
                        </p>

                        <div class="current-images">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <label class="image-tile">
                                    <img src="@img.Url"
                                         alt="@Model.Name"
                                         class="product-image-preview" />
                                    <span class="image-remove">
                                        <input type="checkbox"
                                               name="DeletedImageIds"
                                               value="@img.Id" />
                                        حذف
                                    </span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="image-hint">لا توجد صور لهذه القطعة بعد.</p>
                    }

                    <label class="form-label mt-4" for="newImages">
                        إضافة صور جديدة
                    </label>

                    <input type="file"
                           asp-for="NewImages"
                           id="newImages"
                           class="form-control luxury-input"
                           accept=".jpg,.jpeg,.png,.webp"
                           multiple />

                    <span class="text-danger d-block" id="newImagesError">
                        @Html.ValidationMessage("newImages")
                    </span>

                    <small class="image-hint">
                        يمكنك اختيار أكثر من صورة. الحد الأقصى 5 MB للصورة (JPG, PNG, WEBP).
                    </small>

                    <div class="current-images mt-3" id="newImagesPreview"></div>

                </div>

            </div>

            <!-- Side Preview -->

            <div class="create-side">

                <div class="preview-card">

                    <div class="preview-symbol">✦</div>

                    <span class="preview-label">EDIT PRODUCT</span>

                    <h4>تحديث القطعة</h4>

                    <p>
                        أنت تقوم الآن بتعديل بيانات قطعة موجودة في مخزون المتجر
                    </p>

                    <div class="preview-divider"></div>

                    <div class="preview-detail">
                        <span>رقم المنتج</span>
                        <strong>#@Model.Id</strong>
                    </div>

                    <div class="preview-detail">
                        <span>اسم القطعة</span>
                        <strong>@Model.Name</strong>
                    </div>

                    <div class="preview-detail">
                        <span>الباركود</span>
                        <strong>@(Model.Barcode ?? "غير محدد")</strong>
                    </div>

                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn-save-product">
                        ✦ حفظ التعديلات
                    </button>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn-cancel-product">
                        إلغاء
                    </a>

                </div>

                <div class="secure-note">
                    <span>✓</span>
                    سيتم تحديث بيانات القطعة في قاعدة البيانات
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Live preview of the images chosen in "add new images" + client-side size/type check.
        (function () {
            const input = document.getElementById('newImages');
            const preview = document.getElementById('newImagesPreview');
            const error = document.getElementById('newImagesError');
            const maxBytes = 5 * 1024 * 1024;
            const allowed = ['image/jpeg', 'image/png', 'image/webp'];

            input.addEventListener('change', function () {
                preview.innerHTML = '';
                error.textContent = '';

                for (const file of input.files) {
                    if (!allowed.includes(file.type) || file.size > maxBytes) {
                        error.textContent = 'الملف "' + file.name + '" غير مقبول (النوع أو الحجم).';
                        input.value = '';
                        preview.innerHTML = '';
                        return;
                    }
                    const tile = document.createElement('div');
                    tile.className = 'image-tile';
                    const img = document.createElement('img');
                    img.src = URL.createObjectURL(file);
                    img.alt = file.name;
                    tile.appendChild(img);
                    preview.appendChild(tile);
                }
            });
        })();
    </script>
}

<style>
    /* Modern Minimal - Edit Product */

    .product-create-page {
        direction: rtl;
        color: #292929;
        padding: 15px 0 40px;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .section-eyebrow {
        color: #b08d57;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-heading h2 {
        font-size: 27px;
        font-weight: 700;
        margin: 10px 0;
    }

    .page-heading p {
        color: #999;
        font-size: 14px;
        margin: 0;
    }

    .btn-back {
        background: #fff;
        color: #555;
        border: 1px solid #e9e6e0;
        border-radius: 7px;
        padding: 10px 18px;
        text-decoration: none;
        font-size: 13px;
        transition: .2s;
    }

    .btn-back:hover {
        background: #f7f5f1;
        color: #a88755;
        border-color: #d9c6a7;
    }

    .create-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 290px;
        gap: 24px;
        align-items: start;
    }

    .create-main {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .luxury-card {
        background: #fff;
        border: 1px solid #eeeae4;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 18px rgba(0,0,0,.025);
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding-bottom: 20px;
        margin-bottom: 24px;
        border-bottom: 1px solid #f0eee9;
    }

    .heading-icon {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        background: #f7f4ee;
        color: #a88755;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        flex-shrink: 0;
    }

    .card-heading h5 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .card-heading span {
        color: #999;
        font-size: 12px;
    }

    .product-create-page .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #444;
        margin-bottom: 9px;
    }

    .luxury-input {
        border: 1px solid #e8e5df;
        border-radius: 7px !important;
        min-height: 44px;
        font-size: 13px;
        color: #333;
        background-color: #fff;
        padding: 10px 13px;
        box-shadow: none !important;
    }

    .luxury-input:focus {
        border-color: #b08d57;
        outline: none;
    }

    textarea.luxury-input {
        min-height: auto;
    }

    .gold-addon {
        background: #f7f5f1;
        border: 1px solid #e8e5df;
        color: #9b7848;
        font-size: 13px;
    }

    .image-hint {
        color: #999;
        font-size: 12px;
        line-height: 1.8;
    }

    .current-images {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .image-tile {
        width: 115px;
        background: #faf9f7;
        border: 1px solid #eeeae4;
        border-radius: 10px;
        padding: 7px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .product-image-preview,
    .image-tile img {
        width: 100%;
        height: 95px;
        object-fit: cover;
        border-radius: 7px;
    }

    .image-remove {
        font-size: 12px;
        color: #d35b55;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .image-remove input {
        accent-color: #d35b55;
    }

    .create-side {
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: sticky;
        top: 20px;
    }

    .preview-card {
        background: #f7f5f1;
        border: 1px solid #eeeae4;
        border-radius: 12px;
        padding: 25px;
        text-align: center;
    }

    .preview-symbol {
        font-size: 42px;
        color: #b08d57;
        margin-bottom: 12px;
    }

    .preview-label {
        font-size: 10px;
        letter-spacing: 2px;
        color: #a88755;
        font-weight: 700;
    }

    .preview-card h4 {
        font-size: 19px;
        font-weight: 700;
        margin: 12px 0;
    }

    .preview-card p {
        color: #888;
        font-size: 13px;
        line-height: 1.8;
    }

    .preview-divider {
        border-top: 1px solid #e6e0d5;
        margin: 20px 0;
    }

    .preview-detail {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        margin-bottom: 13px;
    }

    .preview-detail span {
        color: #888;
    }

    .preview-detail strong {
        color: #444;
        overflow-wrap: anywhere;
    }

    .form-actions {
        background: #fff;
        border: 1px solid #eeeae4;
        border-radius: 12px;
        padding: 18px;
    }

    .btn-save-product {
        width: 100%;
        background: #292929;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 13px;
        font-size: 14px;
        font-weight: 600;
        transition: .2s;
    }

    .btn-save-product:hover {
        background: #a88755;
    }

    .btn-cancel-product {
        display: block;
        text-align: center;
        color: #777;
        text-decoration: none;
        padding: 12px;
        font-size: 13px;
    }

    .btn-cancel-product:hover {
        color: #a88755;
    }

    .secure-note {
        color: #888;
        font-size: 11px;
        text-align: center;
        line-height: 1.8;
    }

    .secure-note span {
        color: #6b9b78;
        font-weight: bold;
        margin-left: 5px;
    }

    .product-create-page .text-danger {
        font-size: 12px;
    }

    @@media (max-width: 991px) {
        .create-layout {
            grid-template-columns: 1fr;
        }

        .create-side {
            position: static;
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: start;
        }

        .secure-note {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 576px) {
        .luxury-card {
            padding: 18px;
        }

        .create-side {
            display: flex;
        }

        .page-heading h2 {
            font-size: 22px;
        }
    }
</style>
