
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jewellery</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Jewellery.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            background: #fff;
            color: #292929;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-navbar {
            background: rgba(255,255,255,.97);
            border-bottom: 1px solid #eeeae4;
            padding: 15px 0;
        }

        .navbar-brand {
            color: #292929 !important;
            font-size: 25px;
            font-weight: 700;
            letter-spacing: .5px;
        }

        .navbar-brand i {
            color: #b08d57;
            margin-left: 7px;
        }

        .navbar .nav-link {
            color: #555 !important;
            font-size: 14px;
            font-weight: 500;
            padding: 10px 13px !important;
            margin: 0 2px;
            border-radius: 6px;
            transition: all .25s ease;
        }

        .navbar .nav-link:hover {
            color: #a88755 !important;
            background: #faf8f4;
        }

        .navbar .nav-link.active {
            color: #a88755 !important;
            background: #faf8f4;
            font-weight: 600;
        }

        .cart-link {
            border: 1px solid #d9c6a7;
            color: #9b7848 !important;
            border-radius: 6px !important;
            padding: 9px 16px !important;
            margin-right: 8px !important;
        }

        .cart-link:hover {
            background: #b08d57 !important;
            color: #fff !important;
            border-color: #b08d57;
        }

        main {
            min-height: 70vh;
            padding-top: 30px;
        }

        footer {
            background: #faf9f7;
            border-top: 1px solid #eeeae4;
            padding: 25px 0;
            margin-top: 60px;
            color: #888;
            font-size: 13px;
        }

        .footer-brand {
            color: #a88755;
            font-weight: 600;
        }

        @@media (max-width: 991px) {
            .navbar .nav-link {
                margin: 3px 0;
            }

            .cart-link {
                display: inline-block;
                margin: 8px 0 !important;
            }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light main-navbar">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="fas fa-gem"></i> Jewellery
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                الرئيسية
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shop" ? "active" : "")"
                               asp-controller="Shop" asp-action="Index">
                                <i class="fas fa-store"></i> المتجر
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
                               asp-controller="Products" asp-action="Index">
                                إدارة المنتجات
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Certificates" ? "active" : "")"
                               asp-controller="Certificates" asp-action="Index">
                                الشهادات
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "active" : "")"
                               asp-controller="Invoices" asp-action="Index">
                                الفواتير
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Documents" ? "active" : "")"
                               asp-controller="Documents" asp-action="Index">
                                فحص الوثائق OCR
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link cart-link"
                               asp-controller="Cart"
                               asp-action="Index">
                                <i class="fas fa-shopping-bag"></i>
                                سلة المشتريات
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container text-center">
            <div class="footer-brand mb-2">
                <i class="fas fa-gem"></i> Jewellery
            </div>
            &copy; 2026 Jewellery - جميع الحقوق محفوظة
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
